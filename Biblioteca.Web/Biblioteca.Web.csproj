    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>96132454-aaef-4cec-8306-eeeeee3a3041</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
